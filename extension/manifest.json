{
  "manifest_version": 2,
  "name": "Site Metadata",
  "version": "0.0.1",
  "description": "Automatically fills metadata for websites based on your library.",
  "homepage_url": "https://github.com/BarishNamazov/zotero-site-metadata",
  "author": "Abutalib-Barish Namazov",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "applications": {
    "zotero": {
      "id": "site-metadata@barish.me",
      "update_url": "https://raw.githubusercontent.com/BarishNamazov/zotero-site-metadata/main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.*"
    }
  }
}
